---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Links + Webring :: Jesse Wunderlich"
  description="Jesse Wunderlich's corner of the small web — neighbors, links, and where to find him."
  ogTitle="Jesse's links + webring">
  <div class="box reveal">
    <h2>&gt; cool_links.txt</h2>
    <p class="ring">My neighbors on the small web. Got a handmade site? Let's swap badges.</p>
    <p class="status-line">
      <a href="https://neocities.org" rel="noopener">Neocities</a> &middot;
      <a href="https://melonking.net" rel="noopener">Melonking</a> &middot;
      <a href="https://indieweb.org" rel="noopener">IndieWeb</a>
    </p>
  </div>

  <div class="box reveal">
    <h2>&gt; find_me.txt</h2>
    <ul class="now">
      <li>💾 <a rel="me" href="https://github.com/jessewunderlich">GitHub</a> — where the code lives</li>
      <li>🐦 <a rel="me" href="https://twitter.com/Wund3rl1ch">X / Twitter</a></li>
      <li>📈 <a href="https://novanetworth.com" rel="noopener">Nova</a> — my main project</li>
    </ul>
  </div>
</BaseLayout>
