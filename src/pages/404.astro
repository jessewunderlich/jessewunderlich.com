---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 :: signal lost"
  description="That page wandered off the flight path."
  ogTitle="404 — signal lost">
  <div class="box reveal">
    <h2>&gt; mission_log.txt — entry: anomaly</h2>
    <p class="status-line">status: signal lost &middot; bearing: unknown</p>
    <p class="lead">That page wandered off the flight path — dead link, a typo, or a corner of
    the site that isn't built yet.</p>
    <p class="term-block">
      ERROR 404: TARGET NOT ACQUIRED<br>RETURNING TO BASE
    </p>
    <p>Try one of these instead:</p>
    <ul class="now">
      <li>🏠 <a href="/">back to home</a></li>
      <li>👋 <a href="/about/">about me</a></li>
      <li>🛠️ <a href="/projects/">what I'm building</a></li>
      <li>✍️ <a href="/guestbook/">sign the guestbook</a></li>
    </ul>
  </div>
</BaseLayout>
